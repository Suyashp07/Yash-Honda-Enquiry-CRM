# Database (Neon PostgreSQL with PgBouncer)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/yash_honda?sslmode=require"

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET="super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 (Object Storage for Quotation PDFs and Audio)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="yash-honda-storage"
R2_PUBLIC_URL=""

# Email - Brevo
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="notifications@yashhonda.com"

# WhatsApp - Meta WhatsApp Business Cloud API
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
