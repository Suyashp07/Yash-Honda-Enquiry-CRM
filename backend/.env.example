# Telephony - Exotel
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN=""
EXOTEL_CALLER_ID=""

# AI Insights - Claude API (or compatible LLM)
